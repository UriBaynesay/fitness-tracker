# Copy to .env (never commit it). Used by `docker compose` and by host-side dev/tests.

# --- Database (compose creates it from these) ---
POSTGRES_DB=fitness
POSTGRES_USER=fitness
# Production: openssl rand -hex 24  (hex only: a "/" or "+" breaks connection-string URLs)
POSTGRES_PASSWORD=changeme

# --- Host-side dev: `npm run dev` and `npm test` talk to the compose Postgres
# published on 127.0.0.1:5433 by docker-compose.override.yml. Inside the container,
# compose builds DATABASE_URL itself from the values above, so this is dev-only.
DATABASE_URL=postgresql://fitness:changeme@localhost:5433/fitness
TEST_DATABASE_URL=postgresql://fitness:changeme@localhost:5433/fitness_test

# --- App ---
# Comma-separated origins allowed to make state-changing requests (CSRF guard).
# Dev: the Vite dev server. Production: https://fitness.v1vpa.duckdns.org
ALLOWED_ORIGINS=http://localhost:5173
